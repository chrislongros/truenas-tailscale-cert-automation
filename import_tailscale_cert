#!/bin/bash
set -euo pipefail

# =========================
# USER CONFIG (REQUIRED)
# Fill these in with YOUR values.
# =========================

# 1) Docker container name that runs tailscaled
CONTAINER_NAME="__TAILSCALE_CONTAINER_NAME__"

# 2) The Tailscale HTTPS hostname you want a cert for (your device's *.ts.net name)
TS_HOSTNAME="__TAILSCALE_DNS_NAME__"

# 3) Host directory (on TrueNAS) that is bind-mounted into the container at /certs
#    The container must have:  <HOST_CERT_DIR>  ->  /certs
HOST_CERT_DIR="__HOST_CERT_DIR__"

# 4) Where to write logs (should be writable by root)
LOG_FILE="__LOG_FILE__"

# =========================
# END USER CONFIG
# =========================

CRT="${HOST_CERT_DIR}/ts.crt"
KEY="${HOST_CERT_DIR}/ts.key"

# Cron-safe PATH
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Log from inside the script (cron output may be discarded)
mkdir -p "$(dirname "$LOG_FILE")"
touch "$LOG_FILE"
exec >>"$LOG_FILE" 2>&1
echo "----- $(date -Is) starting tailscale cert import -----"

# Basic dependency checks
command -v docker >/dev/null || { echo "ERROR: docker not found (PATH=$PATH)"; exit 2; }
command -v jq >/dev/null || { echo "ERROR: jq not found (PATH=$PATH)"; exit 2; }
command -v midclt >/dev/null || { echo "ERROR: midclt not found (PATH=$PATH)"; exit 2; }

# Pick a python3 that can import the TrueNAS API client. The client ships
# preinstalled on TrueNAS and provides midclt itself, so midclt's own
# interpreter is the fallback if the default python3 cannot import it.
PY_BIN=""
for candidate in python3 "$(sed -n '1s|^#!\([^ ]*\).*|\1|p' "$(command -v midclt)" 2>/dev/null)"; do
  [[ -n "$candidate" ]] || continue
  command -v "$candidate" >/dev/null 2>&1 || continue
  if "$candidate" -c 'import truenas_api_client' 2>/dev/null \
    || "$candidate" -c 'import middlewared.client' 2>/dev/null; then
    PY_BIN="$candidate"
    break
  fi
done
if [[ -z "$PY_BIN" ]]; then
  echo "ERROR: no python3 found that can import the TrueNAS API client"
  echo "       (tried 'truenas_api_client' and 'middlewared.client')"
  exit 2
fi

# Ensure container is running
if ! docker ps --format '{{.Names}}' | grep -qx "$CONTAINER_NAME"; then
  echo "ERROR: container '$CONTAINER_NAME' is not running"
  docker ps --format 'table {{.Names}}\t{{.Status}}'
  exit 2
fi

# Ensure cert directory exists with safe permissions
mkdir -p "$HOST_CERT_DIR"
chmod 700 "$HOST_CERT_DIR" || true

# Ensure /certs exists in container (mount check)
docker exec "$CONTAINER_NAME" sh -lc 'test -d /certs' || {
  echo "ERROR: /certs missing inside container. Bind-mount HOST_CERT_DIR -> /certs in the container."
  exit 2
}

# Issue/renew cert into /certs (host bind mount)
echo "Using TS_HOSTNAME: $TS_HOSTNAME"
docker exec "$CONTAINER_NAME" sh -lc \
  "tailscale cert --cert-file /certs/ts.crt --key-file /certs/ts.key $TS_HOSTNAME"

# Verify files exist on host
if [[ ! -s "$CRT" || ! -s "$KEY" ]]; then
  echo "ERROR: cert files missing/empty: $CRT / $KEY"
  ls -l "$HOST_CERT_DIR" || true
  exit 2
fi

# Use date-based certificate name for easy tracking
CERT_NAME="tailscale-ui-$(date +%F)"
echo "Importing certificate as: $CERT_NAME"

# Import into TrueNAS cert store.
#
# The cert and key are handed to middleware over its local socket using the
# preinstalled Python API client instead of being embedded in a `midclt`
# command line. A PEM chain plus private key runs to several KB, which can
# overrun the command-line argument length limit and get the import killed
# mid-run (see issue #1). It also keeps the private key out of `ps` output.
#
# midclt only learned to read a JSON payload from stdin in 2026 (TrueNAS 26.x),
# so the API client is the portable path for 24.10 through 26.x.
CERT_ID="$(
  TS_CERT_NAME="$CERT_NAME" TS_CRT_FILE="$CRT" TS_KEY_FILE="$KEY" "$PY_BIN" - <<'PY'
import os
import sys

try:
    from truenas_api_client import Client
except ImportError:
    try:
        from middlewared.client import Client
    except ImportError:
        print("ERROR: no TrueNAS middleware Python API client found", file=sys.stderr)
        sys.exit(2)

name = os.environ["TS_CERT_NAME"]

with open(os.environ["TS_CRT_FILE"]) as fh:
    certificate = fh.read()
with open(os.environ["TS_KEY_FILE"]) as fh:
    privatekey = fh.read()

try:
    with Client() as client:
        existing = client.call("certificate.query", [["name", "=", name]])
        if existing:
            # An earlier run today already imported under this name; reuse it.
            print(existing[-1]["id"])
            sys.exit(0)

        # certificate.create is a job; job=True waits for it to finish so the
        # cert really exists before we point the UI at it.
        created = client.call("certificate.create", {
            "name": name,
            "create_type": "CERTIFICATE_CREATE_IMPORTED",
            "certificate": certificate,
            "privatekey": privatekey,
        }, job=True)
except Exception as exc:
    print("ERROR: certificate import failed: %s" % exc, file=sys.stderr)
    sys.exit(2)

print(created["id"] if isinstance(created, dict) else created)
PY
)"

if [[ -z "${CERT_ID:-}" || "$CERT_ID" == "null" ]]; then
  echo "ERROR: could not determine certificate ID for: $CERT_NAME"
  exit 2
fi

echo "Using imported CERT_ID: $CERT_ID"

# Apply to Web UI and restart UI
midclt call system.general.update "$(jq -n --argjson id "$CERT_ID" '{ui_certificate:$id, ui_restart_delay: 1}')"
midclt call system.general.ui_restart

# Cleanup: remove old tailscale-ui-* certificates (keep only the one just imported)
OLD_CERTS="$(midclt call certificate.query | jq -r --argjson keep "$CERT_ID" \
  '[.[] | select(.name | startswith("tailscale-ui-")) | select(.id != $keep) | .id] | .[]')"

if [[ -n "$OLD_CERTS" ]]; then
  for old_id in $OLD_CERTS; do
    echo "Deleting old certificate ID: $old_id"
    midclt call certificate.delete "$old_id" || echo "WARN: failed to delete cert $old_id"
  done
else
  echo "No old tailscale-ui certificates to clean up"
fi

echo "SUCCESS: applied new UI cert (name=$CERT_NAME id=$CERT_ID)"
